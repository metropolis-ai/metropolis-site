# Plaintext docs are never committed — only the encrypted bundle (docs.enc.js) ships.
*.src.html
*.src.md
# The access passphrase lives here, never committed.
.env
node_modules/
.DS_Store
# Build output — the static site is produced by `vite build` (deployed by CI).
dist/
# Local collaborative review artifacts are never part of the shipped site.
.lavish/
# Plaintext strategy and session records remain local; only encrypted hub output ships.
docs/private-*.md
docs/session-*.md
